#'  Full constraint energy computation
#'  works also without SEN (Ref=NULL)
#' @export
E_FullModel_Penalty<-function (A, grd, bas, Ref)
{
C <- updateX(A, grd, bas)
h2 <- E_SCM(A, grd, bas, C)
if (!is.null(Ref)) {
S <- SEN(A, grd, bas, Ref, h2)
e <- E_SEN(A, grd, bas, S, Ref)
} else {
e = 0
S = NULL
}
E <- h2$Wb + e
for (i in bas$QCons[1:bas$Nc])  E <-  E + M.rho * (h2[[i]] - bas$Target[i])^2
names(E) = NULL
return(list( E=E, Wb = h2$Wb, Ws = e, Euncons = h2$Wb +
e, dA = h2$dA, S = S, Area = h2$Area, Volume = h2$Volume,
Curv = h2$Curv, n = h2$n))
}
MMC(M1,10000,C0=20)->M
#' E_FullModel_Penalty
#' @description
#'  Full constraint energy computation
#'  works also without SEN (Ref=NULL)
#' @export
E_FullModel_Penalty<-function (A, grd, bas, Ref)
{
C <- updateX(A, grd, bas)
h2 <- E_SCM(A, grd, bas, C)
if (!is.null(Ref)) {
S <- SEN(A, grd, bas, Ref, h2)
e <- E_SEN(A, grd, bas, S, Ref)
} else {  e = 0;  S = NULL    }
E <- h2$Wb + e
for (i in bas$QCons[1:bas$Nc])  E <-  E + M.rho * (h2[[i]] - bas$Target[i])^2
names(E) = NULL
return(list( E=E, Wb = h2$Wb, Ws = e, Wuncons = h2$Wb +
e, dA = h2$dA, S = S, Area = h2$Area, Volume = h2$Volume,
Curv = h2$Curv, n = h2$n))
}
